# ===========================================================================
# 扫地机器人智能客服 —— 忽略规则
# ===========================================================================

# ---------------- Python 缓存与构建产物 ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------- 虚拟环境 ----------------
.venv/
venv/
env/
ENV/

# ---------------- 密钥与环境变量 ----------------
# API Key 一律走环境变量，不要提交到仓库
.env
.env.*
!.env.example

# ---------------- IDE ----------------
.idea/
.vscode/
*.iml
*.iws

# ---------------- 运行时产物 ----------------
logs/
*.log

# ---------------- 向量库（本地生成的索引，见 README「构建向量库」） ----------------
# 换机器 / 换 embedding 模型后需要重建：python rag/vector_store.py
chroma_db/
md5.text

# ---------------- 测试与工具缓存 ----------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------- 操作系统文件 ----------------
.DS_Store
Thumbs.db
desktop.ini
